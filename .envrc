# direnv: entering the repository folder loads the same environment as tools/dev/activate.sh,
# and leaving it unloads it. Allow it once with `direnv allow`.
# Personal variables go in .env.local; see tools/dev/env.local.example.

if [ -d .venv/Scripts ]; then
    export VIRTUAL_ENV="$PWD/.venv"
    PATH_add .venv/Scripts
elif [ -d .venv/bin ]; then
    export VIRTUAL_ENV="$PWD/.venv"
    PATH_add .venv/bin
else
    log_status "no .venv yet; run 'source tools/dev/activate.sh' once to create it"
fi

dotenv_if_exists .env.local
export MU3_DEV_ROOT="$PWD"
